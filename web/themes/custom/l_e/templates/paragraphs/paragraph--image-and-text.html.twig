{#
/**
 * @file
 * Theme implementation for the image-and-text paragraph.
 *
 * Paragraph type image_and_text.
 *
 * The image position controls the desktop layout.
 * On mobile, the image always precedes the text.
 */
#}

{%
  set image_position = paragraph.field_paragraph_image_position.value|default('lett')
%}
{%
  set paragraph_classes = [
    'image-and-text',
    'image-and-text--' ~ image_position,
  ]
%}
  <section{{ attributes.addClass(paragraph_classes) }}>
    <div class="row align-items-start g-5">

      <div class="col-12 col-lg-6 image-and-text__image">
        <div class="image-and-text__image-wrapper">
          {{ content.field_paragraph_image }}
        </div>
      </div>

      <div class="col-12 col-lg-6 image-and-text__text">
        {{ content.field_paragraph_text }}
      </div>

    </div>
  </section>
