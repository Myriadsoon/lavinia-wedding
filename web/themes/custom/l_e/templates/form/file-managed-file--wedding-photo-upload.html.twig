{# Keep core's wrapper, controls and hidden values inside its AJAX replacement. #}
<div{{ attributes.addClass('js-form-managed-file', 'form-managed-file') }}>
  {% if element.upload['#access'] is not same as(false) %}
    <div class="wedding-photo-upload__picker">
      {{ element.upload }}
      <label class="wedding-photo-upload__choose" for="{{ element.upload['#id'] }}">
        <i class="bi bi-image wedding-photo-upload__icon" aria-hidden="true"></i>
        <span class="wedding-photo-upload__choose-title">{{ 'Choose a photograph'|t }}</span>
        <span class="wedding-photo-upload__formats">{{ 'JPG, JPEG, PNG or WebP.'|t }}</span>
      </label>
    </div>
  {% else %}
    <div class="wedding-photo-upload__preview" hidden></div>
  {% endif %}
  {{ element|without('upload') }}
</div>
