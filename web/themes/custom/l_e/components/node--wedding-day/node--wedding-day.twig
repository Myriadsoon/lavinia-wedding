{#
/**
 * @file
 * Template for a Node.
 * Available variables:
  * - node: The node entity.
  * - label: The title of the node.
  * - author_name: The name of the author.
  * - author_picture: The picture of the author.
  * - date: The date of the node.
  * - content: All node items. Use {{ content }} to print them all,
  *   or print a subset such as {{ content.field_example }}. Use
  *   {{ content|without('field_example') }} to temporarily suppress the printing
  *   of a given child element.
  * - author: The author of the node.
  * - display_submitted: Whether submission information should be displayed.
  * - attributes: HTML attributes for the containing element.
  * - title_attributes: HTML attributes for the title.
  * - content_attributes: HTML attributes for the content.
  * - author_attributes: HTML attributes for the author.
  * - node_content_classes: A list of HTML classes for the node content.
  * - author_utility_classes: A list of HTML classes for the author.
  * - node_utility_classes: A list of HTML classes for the node.
  * - node_content_utility_classes: A list of HTML classes for the node content.
  * - view_mode: View mode; for example, 'full', 'teaser'.
  * - page: Flag for the full page state.
  * - title_prefix: Additional output populated by modules, intended to be displayed in front of the main title tag that appears in the template.
  * - title_suffix: Additional output populated by modules, intended to be displayed after the main title tag that appears in the template.
  *
 */
#}
{%
  set node_classes = [
    'node',
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    node.bundle|clean_class,
    node.bundle|clean_class ~ '--' ~ view_mode|clean_class,
    'node--' ~ view_mode|clean_class,
    'node--' ~ node.bundle|clean_class ~ '--' ~ view_mode|clean_class,
    'view-mode--' ~ view_mode|clean_class,
  ]|merge(node_utility_classes ?: [])
%}

{%
  set author_classes = [
    'author',
  ]|merge(author_utility_classes ?: [])
%}

{%
  set node_content_classes = [
    'node__content',
  ]|merge(node_content_utility_classes ?: [])
%}

{% set node_attributes = attributes ?: create_attribute() %}

{% set wrapper_element = page ? 'div' : 'article' %}

{# Prepare accordion data. #}

{% set accordion_items = [] %}

{% for event in timeline_events %}
  {% set event_content %}
    <div class="wedding-day__detail-inner wedding-day__moible-detail">

      {% if event.image %}
        <div class="wedding-day__detail-image">
          {{ event.image }}
        </div>
      {% endif %}

      <div class="wedding-day__detail-content">
        {% if event.venue %}
          <div class="wedding-day__venue">
            {{ event.venue }}
          </div>
        {% endif %}

        {% if event.address %}
          <div class="wedding-day__address">
          {{ event.address }}
          </div>
        {% endif %}

        {% if event.description %}
          <div class="wedding-day__description">
            {{ event.description }}
          </div>
        {% endif %}
      </div>

    </div>
  {% endset %}

  {% set accordion_items = accordion_items|merge([
    {
      title: event.time ~ ' ' ~ event.title,
      title_tag: 'h2',
      content: event_content,
      stay_open: false
    }
  ]) %}

{% endfor %}

<{{ wrapper_element }}{{ node_attributes.addClass(node_classes) }}>
  {% block node_title_prefix %}
    {{ title_prefix }}
  {% endblock %}

  {% block node_title %}
    {% if not page %}
      {%
        include 'radix:heading' with {
          content: label|default(''),
          heading_html_tag: heading_html_tag|default('h3'),
          title_link: title_link|default(url),
          heading_attributes: title_attributes,
          heading_utility_classes: [
            'my-3',
            'text-center',
          ],
        }
      %}
    {% endif %}
  {% endblock %}

  {% block node_title_suffix %}
    {{ title_suffix }}
  {% endblock %}

  {% block node_metadata %}
    {% if display_submitted %}
      <footer>
        <div {{ author_attributes.addClass(author_classes) }}>
          {{ author_picture }}

          {{ 'Submitted by @author on @date'|t({
            '@author': author_name,
            '@date': date
          }) }}
        </div>
      </footer>
    {% endif %}
  {% endblock %}

  <div {{ content_attributes.addClass(node_content_classes) }}>
    <div class="wedding-day">

      {# Desktop / tablet: md and above #}
      {% block wedding_day_desktop %}
        <div class="wedding-day__desktop d-none d-md-block">
          <div class="row">

            <div class="col-md-4 col-lg-3">
              {% block wedding_day_timeline %}
                <div
                  class="wedding-day__timeline"
                  role="tablist"
                  aria-orientation="vertical"
                >
                  {% for event in timeline_events %}
                    <button
                      type="button"
                      id="timeline-tab-{{ event.id }}"
                      class="wedding-day__timeline-event{{ loop.first ? ' is-active' : '' }}"
                      role="tab"
                      aria-selected="{{ loop.first ? 'true' : 'false' }}"
                      aria-controls="timeline-panel-{{ event.id }}"
                      tabindex="{{ loop.first ? '0' : '-1' }}"
                      data-timeline-event="{{ event.id }}"
                    >
                      <span class="wedding-day__timeline-time">
                        {{ event.time }}
                      </span>

                      <span class="wedding-day__timeline-marker" aria-hidden="true"></span>

                      <span class="wedding-day__timeline-title">
                        {{ event.title }}
                      </span>

                    </button>
                  {% endfor %}
                </div>
              {% endblock %}
            </div>

            <div class="col-md-8 col-lg-9">
              {% block wedding_day_detail %}
                <div class="wedding-day__detail">

                  {% for event in timeline_events %}
                    <div
                      id="timeline-panel-{{ event.id }}"
                      class="wedding-day__detail-panel{{ loop.first ? ' is-active' : '' }}"
                      role="tabpanel"
                      aria-labelledby="timeline-tab-{{ event.id }}"
                      data-timeline-panel="{{ event.id }}"
                      {% if not loop.first %} hidden {% endif %}
                    >

                      <div class="wedding-day__detail-inner">

                        {% if event.image %}
                          <div class="wedding-day__detail-image">
                            {{ event.image }}
                          </div>
                        {% endif %}

                        <div class="wedding-day__detail-content">

                          <h2 class="wedding-day__detail-title">
                            {{ event.title }}
                          </h2>

                          {% if event.venue %}
                            <div class="wedding-day__venue">
                              {{ event.venue }}
                            </div>
                          {% endif %}

                          {% if event.address %}
                            <div class="wedding-day__address">
                              {{ event.address }}
                            </div>
                          {% endif %}

                          {% if event.description %}
                            <div class="wedding-day__description">
                              {{ event.description }}
                            </div>
                          {% endif %}

                        </div>

                      </div>

                    </div>
                  {% endfor %}

                </div>
              {% endblock %}

            </div>
          </div>
        </div>
      {% endblock %}

      {# Mobile: below md #}
      {% block wedding_day_mobile %}
        <div class="wedding-day__mobile d-md-none">
          {% include 'radix:accordion' with {
            id: 'wedding-day-mobile-timeline',
            items: accordion_items,
            open_item_id: 1,
            flush: true,
            accordion_utility_classes: [
            'wedding-day__accordion'
            ]
          } only %}
        </div>
      {% endblock %}

    </div>

  </div>
</{{ wrapper_element }}>
