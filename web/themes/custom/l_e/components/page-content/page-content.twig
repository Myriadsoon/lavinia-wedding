{#
/**
 * @file
 * Template for page-frontpage component.
 *
 * Available config:
 * - page_header_container_type: sm | md | lg | xl | xxl | fluid.
 * - page_header_container_utility_classes: An array of utility classes.
 * - page_content_container_type: sm | md | lg | xl | xxl | fluid | false | true.
 * - page_content_container_utility_classes: An array of utility classes.
 * - page_main_utility_classes: An array of utility classes.
 *
 * Available blocks:
 * - page_header
 * - page_inner_content
 */
#}
{% set page_header_container_attributes = page_header_container_attributes ?: create_attribute() %}
{% set page_content_container_attributes = page_content_container_attributes ?: create_attribute() %}
{% set page_hero_attributes = page_hero_attributes ? : create_attribute() %}
{% set page_main_attributes = page_main_attributes ? : create_attribute() %}

{%
  set page_main_classes = []|merge(page_main_utility_classes ?: [])
%}
{%
  set page_hero_classes = []|merge(page_hero_utility_classes ?: [])
%}

{% set header_container_class = '' %}
{% if page_header_container_type is null %}
  {% set header_container_class = 'container' %}
{% elseif page_header_container_type is not empty %}
  {% set header_container_class = 'container-' ~ page_header_container_type %}
{% endif %}
{%
  set page_header_container_classes = [
    header_container_class
  ]|merge(page_header_container_utility_classes ?: [])
%}

{% set content_container_class = '' %}
{% if page_content_container_type is null %}
  {% set content_container_class = 'container' %}
{% elseif page_content_container_type is not empty %}
  {% set content_container_class = 'container-' ~ page_content_container_type %}
{% endif %}
{%
  set page_content_container_classes = [
    content_container_class
  ]|merge(page_content_container_utility_classes ?: [])
%}


  {% if page.hero %}
    <div{{ page_hero_attributes.addClass(page_hero_classes)}}>
      {% block page_hero %}
        {{ page.hero }}
      {% endblock %}
    </div>
  {% endif %}


<main{{page_main_attributes.addClass(page_main_classes)}}>
	{% if page.header %}
		<header class="page__header">
			<div {{ page_header_container_attributes.addClass(page_header_container_classes) }}>
				{% block page_header %}
					{{ page.header }}
				{% endblock %}
			</div>
		</header>
	{% endif %}


	{% if page.content %}
    <div class="page__content" id="main-content">
      <div {{ page_content_container_attributes.addClass(page_content_container_classes) }}>

        {# Sidebar is optional; main content must never depend on it #}
        {# see 'is_user_router' variable set in inlcudes/content.theme file #}
        {% set has_sidebar = page.sidebar is not empty and not (is_user_route ?? false) %}

        <div class="row g-4">
          {# LEFT sidebar (only when present) #}
          {% if has_sidebar %}

            <div class="col-12 col-lg-3 order-2 order-lg-1">

              {# Toggler visible only below lg #}
              <div class="d-lg-none mb-3">
                <button
                  class="btn btn-outline-secondary w-100"
                  type="button"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#sidebarOffcanvas"
                  aria-controls="sidebarOffcanvas"
                >
                  Browse Events
                </button>
              </div>

              <div class="position-sticky lavinia-wedding-sidebar-sticky">
                {# Offcanvas below lg, static panel on lg+ (Radix handles this pattern #}
                {% include "radix:offcanvas" with {
                  offcanvas_id: "sidebarOffcanvas",
                  placement: "start",
                  offcanvas_title: "Eventss",
                  close_button: true,
                  offcanvas_content: page.sidebar
                } only %}
              </div>
            </div>
          {% endif %}
        </div>

        <div class="{{ has_sidebar ? 'col-12 col-lg-9 order-1 order-lg-2' : 'col-12' }}">
          {% block page_inner_content_with_sidebar %}
            {{ page.content }}
          {% endblock %}
        </div>
      </div>
    </div>
  {% endif %}
</main>
