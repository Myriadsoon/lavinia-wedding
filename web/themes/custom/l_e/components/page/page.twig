{#
/**
 * @file
 * Template for the main page.
 */
#}
{% set page_attributes = attributes ?: create_attribute() %}
{% set
  page_classes = [
    'page',
  ]|merge(page_utility_classes ?: [])
%}

<div {{ page_attributes.addClass(page_classes) }}>
	{% block page_navigation %}
		{% include 'l_e:page-navigation' %}
	{% endblock %}

  {% block page_content %}

    {% set page_content_props = {
      page_main_utility_classes: ['pb-4'],
      page_header_container_utility_classes: ['mb-4'],
      page_hero_utility_classes: ['page__hero'],
      decorative_frame: decorative_frame,
    } %}

    {% if alternative_text_image_page %}
      {% set page_content_props = page_content_props|merge({
        page_content_container_type: 'fluid',
        page_content_container_utility_classes: [
          'alternating-content-container'
        ],
      }) %}
    {% endif %}

    {% include 'l_e:page-content' with page_content_props %}

  {% endblock %}

	{% block page_footer %}
		{% include 'radix:page-footer' %}
	{% endblock %}
</div>
