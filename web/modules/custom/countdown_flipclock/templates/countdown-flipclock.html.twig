<section class="countdown-flipclock" data-countdown-flipclock>
  <h2 class="countdown-flipclock__title">{{ title }}</h2>

  <div class="countdown-flipclock__units">
    {% for unit, value in units %}
      <div class="countdown-flipclock__unit" data-countdown-unit="{{ unit }}">
        <div class="countdown-flipclock__card" data-flipcard>
          <div class="countdown-flipclock__card-face countdown-flipclock__card-face--top" data-flipcard-top>
            <span>{{ value }}</span>
          </div>

          <div class="countdown-flipclock__card-face countdown-flipclock__card-face--bottom" data-flipcard-bottom>
            <span>{{ value }}</span>
          </div>

          <div class="countdown-flipclock__card-flap countdown-flipclock__card-flap--top" data-flipcard-top-flap>
            <span>{{ value }}</span>
          </div>

          <div class="countdown-flipclock__card-flap countdown-flipclock__card-flap--bottom" data-flipcard-bottom-flap>
            <span>{{ value }}</span>
          </div>
        </div>

        <div class="countdown-flipclock__label">
          {{ unit|capitalize }}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

