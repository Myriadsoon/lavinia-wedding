{% set trigger_attributes = create_attribute()
  .setAttribute('type', 'button')
  .setAttribute('data-bs-toggle', 'offcanvas')
  .setAttribute('data-bs-target', '#wedding-account-offcanvas')
  .setAttribute('aria-controls', 'wedding-account-offcanvas')
%}

{% embed 'radix:button' with {
  button_attributes: trigger_attributes,
  button_utility_classes: [
    'wedding-account__trigger',
  ],
} %}
  {% block content %}
    <i class="bi bi-person" aria-hidden="true"></i>
    <span class="visually-hidden">
      {{ 'Open account menu'|t }}
    </span>
  {% endblock %}
{% endembed %}
