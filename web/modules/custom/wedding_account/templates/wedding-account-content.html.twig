{#
Radix only renders the offcanvas_body block when
offcanvas_content is truthy. Supply a non-empty string
to satisfy that condition and the component's string schema.
The actual content is provided by the block override below.
#}
{% embed 'radix:offcanvas' with {
  offcanvas_id: 'wedding-account-offcanvas',
  placement: 'end',
  offcanvas_title: 'Your account'|t,
  offcanvas_title_tag: 'h2',
  offcanvas_content: 'Provided by offcanvas_body block',
} %}

  {% block offcanvas_toggler %}
  {% endblock %}

  {% block offcanvas_body %}
    {% if logged_in %}
      <p>{{ 'Hello, '|t }}<strong>{{ display_name }}</strong> </p>

      <nav aria-label="{{ 'Account options'|t }}">
        <ul class="list-unstyled">
          <li>
            <a href="{{ account_url }}">{{ 'My account'|t }}</a>
          </li>
          <li>
            <a href="{{ logout_url }}">{{ 'Logout'|t }}</a>
          </li>
        </ul>
      </nav>
    {% else %}
      <p>{{ 'Sign in to view and update your wedding details.'|t }}</p>

      <nav aria-label="{{ 'Account options'|t }}">
        <ul class="list-unstyled">
          <li>
            <a href="{{ login_url }}">
              {{ 'Sign in'|t }}
            </a>
          </li>
          <li>
            <a href="{{ password_url }}">
              {{ 'Forgotten password. Reset option.'|t }}
            </a>
          </li>
        </ul>
      </nav>
    {% endif %}

    {% if guest_available %}
      <div class="wedding-account__guest-status">
        <h3 class="h6">{{ 'Wedding Form Completion'|t }}</h3>

        {% if guest_complete %}
          <p class="wedding-account__status wedding-account__status--complete">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>{{ 'Thank you for completing the guest form.'|t }}</span>
          </p>

          <a class="btn button-secondary" href="{{ guest_details_url }}">
            {{ 'View / modify form'|t }}
          </a>

        {% else %}
          <p class="wedding-account__status wedding-account__status--incomplete">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>{{ "Please do complete the wedding guest form"|t }}</span>
          </p>

          <a class="btn button-secondary" href="{{ guest_details_url }}">
            {{ 'Guest form.'|t }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if can_upload_photos or can_moderate_photos %}
      <div class="wedding-account__photos">
        <h3 class="h6">{{ 'Photographs'|t }}</h3>

        <p>
          {{ 'Share your photographs from the wedding with us.'|t }}
        </p>

        <div class="wedding-account__photo-actions d-flex flex-column align-items-start gap-2">
          {% if can_upload_photos %}
            <a class="btn button-secondary" href="{{ photo_upload_url }}">
              <i class="bi bi-image" aria-hidden="true"></i>
              <span>{{ 'Share your photographs'|t }}</span>
            </a>
          {% endif %}

          {% if can_moderate_photos %}
            <a class="btn button-secondary" href="{{ photo_moderation_url }}">
              <i class="bi bi-upload" aria-hidden="true"></i>
              <span>{{ 'Moderate photographs'|t }}</span>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

  {% endblock %}

{% endembed %}
