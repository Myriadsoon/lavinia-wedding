<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\user\Entity\User;

/**
 * Implements hook_theme().
 */
function wedding_account_theme($existing, $type, $theme, $path) {
  return [
    'wedding_account_trigger' => [
      'variables' => [],
    ],
    'wedding_account_content' => [
      'variables' => [
        'logged_in' => FALSE,
        'display_name' => NULL,
        'account_url' => NULL,
        'logout_url' => NULL,
        'guest_available' => FALSE,
        'guest_complete' => FALSE,
        'guest_details_url' => NULL,
        'can_upload_photos' => NULL,
        'photo_upload_url' => NULL,
        'can_moderate_photos' => NULL,
        'photo_moderation_url' => NULL,
        'login_url' => NULL,
        'password_url' => NULL,
      ],
    ],
    'wedding_account' => [
      'variables' => [
        'username' => NULL,
        'gallery_only' => FALSE,
        'email' => NULL,
        'account_form' => NULL,
        'guest_response' => NULL,
        'guest_details_url' => NULL,
        'photo_upload_url' => NULL,
        'photographs' => NULL,
        'can_access_wedding_reports' => NULL,
        'wedding_reports_url' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter()
 */
function wedding_account_form_user_form_alter(&$form, &$form_state):void {
  $current_user = \Drupal::currentUser();
  $account = $form_state->getFormObject()->getEntity();

  // Check to see if current user is altering their user form and
  // that they have the 'wedding_guest' role. So that Administrators
  // can still access full user form to make amendments.
  if (
    (int) $current_user->id() !== (int) $account->id()
    || in_array('administrator', $current_user->getRoles(), TRUE)
    || !array_intersect(
      ['wedding_guest', 'wedding_gallery_viewer'],
      $current_user->getRoles()
    )
  ) {
    return;
  }

//  // Remove account fields that a wedding guest should not edit.
  $form['account']['name']['#access'] = FALSE;
  $form['account']['status']['#access'] = FALSE;
  $form['account']['roles']['#access'] = FALSE;
  $form['account']['notify']['#access'] = FALSE;

//  // Remove profile settings that are not relevant to wedding guests.
  $form['language']['#access'] = FALSE;
  $form['timezone']['#access'] = FALSE;
  $form['user_picture']['#access'] = FALSE;

  // Adapt Drupal's user form for the wedding guest account experience
  $form['account']['#type'] = 'fieldset';
  $form['account']['#title'] = t('Account details');

  $form['account']['mail']['#title'] = t('Email address');
  $form['account']['mail']['#description'] = t(
    'This is the email address you use to sign in. To change it, enter
      a new email address here and confirm the change with your current password below.'
  );

  $form['account']['current_pass']['#title'] = t('Current password');
  $form['account']['current_pass']['#description'] = t(
    'Your current password is required if you want to change your email address or password.'
  );

  $form['account']['pass']['#description'] = t(
    'Enter a new password only if you want to change your current password.'
  );

  $form['actions']['submit']['#value'] = t('Save changes');

  $form['account']['mail']['#weight'] = 0;
  $form['account']['current_pass']['#weight'] = 10;
  $form['account']['pass']['#weight'] = 20;

  // Retain an accessible fieldset label without repeating page heading.
  if (isset($form['account'])) {
    $form['account']['#title'] = t('Edit your account information');
  }

  // Redirect after initial password setup via a one-time login link
  if (\Drupal::request()->query->has('pass-reset-token')) {
    $form['actions']['submit']['#submit'][] =
      'wedding_account_initial_password_redirect';
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function wedding_account_form_user_login_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
  // Run after core has authenticated the user.
  $form['#submit'][] = 'wedding_account_login_redirect';
}

/**
 * Sets the default destination after an ordinary browser login.
 */
function wedding_account_login_redirect(
  array &$form,
  FormStateInterface $form_state,
): void {
  if ($form_state->isProgrammed() || $form_state->getResponse()) {
    return;
  }

  $uid = $form_state->get('uid');
  $current_user = \Drupal::currentUser();
  if (!$uid || !$current_user->isAuthenticated()
    || (int) $current_user->id() !== (int) $uid) {
    return;
  }

  $account = User::load($uid);
  if (!$account) {
    return;
  }

  $roles = $account->getRoles(TRUE);
  $gallery_only = count($roles) === 1
    && in_array('wedding_gallery_viewer', $roles, TRUE);

  $language_manager = \Drupal::languageManager();
  $language = $language_manager->getLanguage(
    $account->getPreferredLangcode(),
  ) ?? $language_manager->getDefaultLanguage();

  // Gallery-only visitors must always reach the gallery.
  if ($gallery_only) {
    $url = Url::fromRoute(
      'view.wedding_photos_gallery.page_1',
      [],
      ['language' => $language],
    );

    // Prevent the original destination from overriding our redirect.
    \Drupal::request()->query->remove('destination');
    \Drupal::request()->request->remove('destination');

    $form_state->setRedirectUrl($url);
    return;
  }

  // Preserve explicit destinations for other users.
  $request = \Drupal::request();
  if ($request->query->has('destination')
    || $request->request->has('destination')) {
    return;
  }

  // Other authenticated users return to the homepage
  $url = Url::fromRoute(
    '<front>',
    [],
    ['language' => $language],
  );

  $form_state->setRedirectUrl($url);

}

/**
 * Redirects guests after completing initial password setup
 */
function wedding_account_initial_password_redirect(
  array &$form,
  FormStateInterface $form_state,
): void {
  $account = $form_state->getFormObject()->getEntity();

  if (!$account || $account->isNew()) {
    return;
  }

  // Respect an explicit destination, if present
  $roles = $account->getRoles(TRUE);

  $gallery_only = count($roles) === 1
    && in_array('wedding_gallery_viewer', $roles, TRUE);

  // Preserve explicit destination for other account types.
  $request = \Drupal::request();

  if ($gallery_only) {
    // Gallery-only users must return to the gallery
    $request->query->remove('destination');
    $request->request->remove('destination');
  }
  elseif (
    $request->query->has('destination')
    || $request->request->has('destination')
  ) {
    return;
  }

  // Use the account's preferred language
  $language_manager = \Drupal::languageManager();
  $language = $language_manager->getLanguage(
    $account->getPreferredLangcode(),
  ) ?? $language_manager->getDefaultLanguage();

  $url = Url::fromRoute(
    $gallery_only ? 'view.wedding_photos_gallery.page_1' : '<front>',
    [],
    ['language' => $language],
  );

  $form_state->setRedirectUrl($url);
}
